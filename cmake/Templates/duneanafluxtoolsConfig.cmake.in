@PACKAGE_INIT@

if(TARGET duneanafluxtools::all)
  set(duneanafluxtools_FOUND TRUE)
  return()
endif()

set(duneanafluxtools_VERSION @PROJECT_VERSION@)
set(duneanafluxtools_CXX_STANDARD 17)

if(NOT TARGET ROOT::RIO)
  find_package(ROOT 6 REQUIRED)
endif()

get_filename_component(duneanafluxtools_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
LIST(APPEND CMAKE_MODULE_PATH ${duneanafluxtools_CMAKE_DIR})

set(duneanafluxtools_FOUND TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/duneanafluxtoolsTargets.cmake)

if(NOT TARGET duneanafluxtools::all)
  set(duneanafluxtools_FOUND FALSE)
  return()
endif()

find_path(duneanafluxtools_INCLUDE_DIR
  NAMES duneanafluxtools.h
  PATHS ${duneanafluxtools_CMAKE_DIR}/../../../include/
)

find_path(duneanafluxtools_LIB_DIR
  NAMES libduneanafluxtools.so libduneanafluxtools.dylib
  PATHS ${duneanafluxtools_CMAKE_DIR}/../../
)

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(duneanafluxtools
    REQUIRED_VARS
      duneanafluxtools_INCLUDE_DIR
      duneanafluxtools_LIB_DIR
    VERSION_VAR
      duneanafluxtools_VERSION
)

message(STATUS "Found duneanafluxtools Version: ${duneanafluxtools_VERSION} in \"${duneanafluxtools_CMAKE_DIR}\"")
message(STATUS "    duneanafluxtools_INCLUDE_DIR: ${duneanafluxtools_INCLUDE_DIR}")
message(STATUS "    duneanafluxtools_LIB_DIR: ${duneanafluxtools_LIB_DIR}")
